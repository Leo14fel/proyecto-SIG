<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="TextColor" Value="#142F4A" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="PageSubtitle" TargetType="Label">
        <Setter Property="TextColor" Value="#0F766E" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="PageBody" TargetType="Label">
        <Setter Property="TextColor" Value="#334155" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="PageCaption" TargetType="Label">
        <Setter Property="TextColor" Value="#64748B" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="PageStatus" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#0F766E" />
    </Style>
    <Style x:Key="HeaderButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>
    <Style x:Key="CompactButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#991B1B" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>
</ResourceDictionary>
