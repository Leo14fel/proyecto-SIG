@model VisorDatosSIG.Web.Models.GeographicRecordDetailViewModel
@{ ViewData["Title"] = $"Detalle {Model.LayerName}"; }
<nav class="breadcrumb" aria-label="Miga de pan"><a href="@Model.ReturnUrl">Registros geográficos</a><span aria-hidden="true">/</span><span>@Model.LayerName</span></nav>
<section class="detail-card">
    <p class="eyebrow">@Model.LayerName</p>
    <h1 id="record-title">Ficha geográfica</h1>
    <p>Información oficial almacenada en SQL Server.</p>
    <dl id="record-attributes" class="record-detail-list" hidden></dl>
    <script id="record-presentation" type="application/json">@Json.Serialize(new { layer = Model.LayerKey, properties = Model.Properties })</script>
    <div class="detail-actions">
        @if (TempData["OperationMessage"] is string message)
        {
            <p class="w-100" role="status">@message</p>
        }
        @if (User.IsInRole("Administrador") && Model.LayerKey == "codigos-fijos" && Model.Properties.TryGetValue("Estado", out var state) && state is byte status && status == 1)
        {
            <form asp-controller="Operaciones" asp-action="PrepararCorte" asp-route-id="@Model.Id" method="post" data-confirm-action="¿Marcar esta conexión para corte?">
                <button class="btn btn-outline-danger">Marcar para corte</button>
            </form>
        }
        <a class="btn btn-primary" href="/Visor?capa=@Uri.EscapeDataString(Model.LayerKey)&id=@Model.Id&volver=@Uri.EscapeDataString(Model.ReturnUrl)">Ver en visor</a>
        <a class="btn btn-outline-secondary" href="@Model.ReturnUrl">Volver a resultados</a>
    </div>
</section>
@section Scripts {
    <script src="~/js/geographic-search.js" asp-append-version="true"></script>
    <script>
        const record = JSON.parse(document.getElementById('record-presentation').textContent);
        const presentation = window.geographicSearch.describe(record.layer, record.properties);
        document.getElementById('record-title').textContent = presentation.title;
        const attributes = document.getElementById('record-attributes');
        for (const [name, value] of presentation.details) {
            const label = document.createElement('dt');
            const description = document.createElement('dd');
            label.textContent = name;
            description.textContent = value;
            attributes.append(label, description);
        }
        attributes.hidden = !presentation.details.length;
    </script>
}
