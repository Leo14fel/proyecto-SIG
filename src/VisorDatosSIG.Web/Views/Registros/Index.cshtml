@{ ViewData["Title"] = "Registros geográficos"; }
<partial name="_ModuleHeading" model='("data", "Registros geográficos", "Busca registros por capa y abre su ficha o ubicación exacta en el mapa.")' />

<section class="records-card" aria-label="Consulta de registros">
    <div class="records-toolbar">
        <div class="record-tabs" role="tablist" aria-label="Capas geográficas">
            <button type="button" class="record-tab active" data-layer="todas" role="tab" aria-selected="true">Todas</button>
            <button type="button" class="record-tab" data-layer="manzanas" role="tab" aria-selected="false">Manzanas</button>
            <button type="button" class="record-tab" data-layer="lotes" role="tab" aria-selected="false">Lotes</button>
            <button type="button" class="record-tab" data-layer="codigos-fijos" role="tab" aria-selected="false">Conexiones de agua</button>
            <button type="button" class="record-tab" data-layer="vias" role="tab" aria-selected="false">Vías</button>
        </div>
        <form id="records-form" class="records-filter" role="search">
            <label class="visually-hidden" for="records-query">Buscar registros</label>
            <input id="records-query" type="search" class="form-control" maxlength="100" aria-describedby="records-hint" />
            <select id="records-field" class="form-select" aria-label="Buscar por"></select>
            <select id="records-comparison" class="form-select" aria-label="Comparación">
                <option value="contiene">Contiene</option><option value="igual">Igual</option><option value="comienza-con">Comienza con</option>
            </select>
            <button class="btn btn-primary" type="submit"><partial name="_Icon" model='"search"' /> Buscar</button>
            <button id="records-clear" class="btn btn-outline-secondary" type="button">Limpiar</button>
        </form>
        <p id="records-hint" class="form-text mb-0"></p>
    </div>
    <p id="records-status" class="records-status" role="status">Cargando registros…</p>
    <div id="records-results" class="records-results"></div>
    <nav id="records-pagination" class="records-pagination" aria-label="Paginación de registros"></nav>
</section>

@section Scripts {
<script src="~/js/geographic-search.js" asp-append-version="true"></script>
<script>
(() => {
    const geographic = window.geographicSearch;
    const query = new URLSearchParams(location.search);
    let layer = Object.hasOwn(geographic.layers, query.get('capa')) ? query.get('capa') : 'todas';
    const requestedPage = Number(query.get('pagina'));
    let page = Number.isSafeInteger(requestedPage) && requestedPage >= 1 && requestedPage <= 2147483647 ? requestedPage : 1;
    let controller;
    const form = document.getElementById('records-form');
    const term = document.getElementById('records-query');
    const field = document.getElementById('records-field');
    const comparison = document.getElementById('records-comparison');
    const status = document.getElementById('records-status');
    const results = document.getElementById('records-results');
    const pagination = document.getElementById('records-pagination');
    const hint = document.getElementById('records-hint');
    term.value = query.get('q') || '';

    function updateFilter() {
        geographic.updateOperator(field, comparison);
        hint.textContent = field.value ? 'Escribe solo el valor del campo seleccionado.' : geographic.layers[layer].hint;
    }
    function populateFields() {
        geographic.setup(layer, term, field, comparison, query.get('campo'), query.get('operador'));
        updateFilter();
    }
    function navigationUrl(item) {
        const itemLayer = item.layerKey || layer;
        const back = `/Registros?${new URLSearchParams({ capa: layer, q: term.value.trim(), campo: field.value, operador: comparison.value, pagina: String(page) })}`;
        return { detail: `/Registros/${encodeURIComponent(itemLayer)}/${item.id}?volver=${encodeURIComponent(back)}`, viewer: `/Visor?capa=${encodeURIComponent(itemLayer)}&id=${item.id}&volver=${encodeURIComponent(back)}` };
    }
    function escapeText(value) { const node = document.createElement('span'); node.textContent = value ?? '—'; return node.innerHTML; }
    function render(data) {
        status.textContent = data.total ? `${data.total.toLocaleString('es-BO')} resultados · página ${data.pagina} de ${Math.max(1, Math.ceil(data.total / data.tamanoPagina))}` : 'No se encontraron registros. Prueba con parte del nombre o cambia la capa.';
        results.replaceChildren(); pagination.replaceChildren();
        data.items.forEach(item => {
            const urls = navigationUrl(item);
            const description = geographic.describe(item.layerKey || layer, item.properties);
            const row = document.createElement('article'); row.className = 'record-item';
            const details = description.details.map(([label, value]) => `${escapeText(label)}: ${escapeText(value)}`).join(' · ');
            row.innerHTML = `<div><span class="record-layer">${escapeText(description.layer)}</span><h2>${escapeText(description.title)}</h2>${details ? `<p>${details}</p>` : ''}</div><div class="record-actions"><a class="btn btn-outline-primary btn-sm" href="${urls.detail}">Ver detalle</a><a class="btn btn-primary btn-sm" href="${urls.viewer}">Ver en visor</a></div>`;
            results.append(row);
        });
        if (data.total > data.tamanoPagina) {
            const previous = document.createElement('button'); previous.type = 'button'; previous.className = 'btn btn-outline-secondary btn-sm'; previous.textContent = 'Anterior'; previous.disabled = page === 1; previous.onclick = () => load(page - 1);
            const next = document.createElement('button'); next.type = 'button'; next.className = 'btn btn-outline-secondary btn-sm'; next.textContent = 'Siguiente'; next.disabled = page >= Math.ceil(data.total / data.tamanoPagina); next.onclick = () => load(page + 1);
            pagination.append(previous, next);
        }
    }
    async function load(nextPage = 1) {
        page = nextPage; controller?.abort(); controller = new AbortController(); status.textContent = 'Consultando SQL Server…'; results.replaceChildren(); pagination.replaceChildren();
        const params = new URLSearchParams({ capa: layer, pagina: String(page), tamanoPagina: '25' });
        if (term.value.trim()) params.set('q', term.value.trim());
        if (term.value.trim() && field.value) { params.set('campo', field.value); params.set('operador', comparison.value); }
        history.replaceState(null, '', `/Registros?${params}`);
        try { const response = await fetch(`/api/registros?${params}`, { signal: controller.signal }); const data = await response.json(); if (!response.ok) throw new Error(data.message || 'No fue posible consultar los registros.'); render(data); }
        catch (error) { if (error.name !== 'AbortError') status.textContent = error.message; }
    }
    const tabs = [...document.querySelectorAll('.record-tab')];
    function selectTab(tab) {
        tabs.forEach(item => {
            const active = item === tab;
            item.classList.toggle('active', active);
            item.setAttribute('aria-selected', String(active));
            item.tabIndex = active ? 0 : -1;
        });
    }
    tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
            layer = tab.dataset.layer;
            query.delete('campo');
            query.delete('operador');
            selectTab(tab);
            populateFields();
            load();
        });
        tab.addEventListener('keydown', event => {
            const offset = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
            if (!offset) return;
            event.preventDefault();
            const next = tabs[(index + offset + tabs.length) % tabs.length];
            next.focus();
            next.click();
        });
    });
    form.addEventListener('submit', event => { event.preventDefault(); load(1); });
    field.addEventListener('change', updateFilter);
    document.getElementById('records-clear').addEventListener('click', () => { term.value = ''; field.value = ''; updateFilter(); load(1); });
    selectTab(tabs.find(tab => tab.dataset.layer === layer));
    populateFields();
    load(page);
})();
</script>
}
