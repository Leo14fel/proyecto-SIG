@{ ViewData["Title"] = "Ayuda"; }
<section class="detail-card">
    <partial name="_ModuleHeading" model='("help", "Ayuda", "Guía rápida para consultar el territorio y trabajar en campo.")' />
    <ol class="mb-0">
        <li>Use <strong>Registros geográficos</strong> para buscar y revisar entidades individuales.</li>
        <li>Use <strong>Ver en visor</strong> para centrar y resaltar la geometría real por su identificador SQL.</li>
        <li>En el Visor, Lotes requiere zoom 16 cuando se consulta como capa general.</li>
        <li>En móvil, abra la navegación mediante el botón de menú.</li>
        <li>En <strong>Asignaciones</strong>, marca el origen en el mapa y revisa la ruta antes de guardarla.</li>
        <li>En <strong>Mis tareas</strong>, concede ubicación y cámara para registrar el resultado desde Android.</li>
    </ol>
</section>
