@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">No se pudo completar la solicitud</h1>
<p>Intenta de nuevo. Si el problema continúa, comparte el código de referencia con el administrador.</p>

@if (Model.ShowRequestId)
{
    <p>Código de referencia <code>@Model.RequestId</code></p>
}

@if (User.Identity?.IsAuthenticated == true)
{
    <a asp-controller="Home" asp-action="Index">Volver al panel</a>
}
else
{
    <a asp-controller="Cuenta" asp-action="Login">Volver al inicio de sesión</a>
}
