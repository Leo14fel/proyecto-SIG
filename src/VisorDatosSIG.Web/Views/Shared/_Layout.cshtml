@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    bool IsActive(string target, string? targetAction = null) => string.Equals(controller, target, StringComparison.OrdinalIgnoreCase) && (targetAction is null || string.Equals(action, targetAction, StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#142f4a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <title>@ViewData["Title"] - VisorDatosSIG</title>
    <partial name="_PwaHead" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VisorDatosSIG.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/interface.css" asp-append-version="true" />
</head>
<body class="app-shell">
    <a class="skip-link" href="#main-content">Ir al contenido</a>
    <button id="sidebar-toggle" class="sidebar-mobile-toggle" type="button" aria-label="Abrir navegación" aria-controls="app-sidebar" aria-expanded="false"><partial name="_Icon" model='"menu"' /></button>
    <div id="sidebar-backdrop" class="sidebar-backdrop" hidden></div>
    <aside id="app-sidebar" class="app-sidebar" aria-label="Navegación principal">
        <div class="sidebar-brand"><i class="brand-mark"><partial name="_Icon" model='"map"' /></i><span>VisorDatosSIG</span><button id="sidebar-collapse" type="button" class="sidebar-collapse" aria-label="Contraer navegación" title="Contraer navegación" aria-controls="app-sidebar" aria-expanded="true">‹</button><button id="sidebar-close" class="sidebar-close" type="button" aria-label="Cerrar navegación"><partial name="_Icon" model='"close"' /></button></div>
        <nav class="sidebar-nav">
            <p class="nav-group">Territorio</p>
            <a class="@(IsActive("Home", "Index") ? "active" : "")" aria-current="@(IsActive("Home", "Index") ? "page" : null)" asp-controller="Home" asp-action="Index" title="Panel principal"><partial name="_Icon" model='"grid"' /><span>Panel principal</span></a>
            <a class="@(IsActive("Visor") ? "active" : "")" aria-current="@(IsActive("Visor") ? "page" : null)" asp-controller="Visor" asp-action="Index" title="Visor cartográfico"><partial name="_Icon" model='"map"' /><span>Visor cartográfico</span></a>
            <a class="@(IsActive("Registros") ? "active" : "")" aria-current="@(IsActive("Registros") ? "page" : null)" asp-controller="Registros" asp-action="Index" title="Registros geográficos"><partial name="_Icon" model='"data"' /><span>Registros geográficos</span></a>
            @if (User.IsInRole("Administrador"))
            {
                <p class="nav-group">Operaciones de agua</p>
                <a class="@(IsActive("Operaciones", "Asignaciones") ? "active" : "")" aria-current="@(IsActive("Operaciones", "Asignaciones") ? "page" : null)" asp-controller="Operaciones" asp-action="Asignaciones" title="Asignaciones"><partial name="_Icon" model='"route"' /><span>Asignaciones</span></a>
                <a class="@(IsActive("Operaciones", "Monitoreo") ? "active" : "")" aria-current="@(IsActive("Operaciones", "Monitoreo") ? "page" : null)" asp-controller="Operaciones" asp-action="Monitoreo" title="Monitoreo"><partial name="_Icon" model='"pulse"' /><span>Monitoreo</span></a>
            }
            @if (User.IsInRole("Cortador") || User.IsInRole("Reconexion"))
            {
                <a class="@(IsActive("Operaciones", "Campo") ? "active" : "")" aria-current="@(IsActive("Operaciones", "Campo") ? "page" : null)" asp-controller="Operaciones" asp-action="Campo" title="Mis tareas"><partial name="_Icon" model='"list"' /><span>Mis tareas</span></a>
            }
            <p class="nav-group">Sistema</p>
            @if (User.IsInRole("Administrador")) { <a class="@(IsActive("Administracion") ? "active" : "")" aria-current="@(IsActive("Administracion") ? "page" : null)" asp-controller="Administracion" asp-action="Usuarios" title="Administración"><partial name="_Icon" model='"users"' /><span>Administración</span></a> }
            <a class="@(IsActive("Home", "Ayuda") ? "active" : "")" aria-current="@(IsActive("Home", "Ayuda") ? "page" : null)" asp-controller="Home" asp-action="Ayuda" title="Ayuda"><partial name="_Icon" model='"help"' /><span>Ayuda</span></a>
        </nav>
        <div class="sidebar-account">
            <a asp-controller="CuentaPerfil" asp-action="MiPerfil" aria-current="@(IsActive("CuentaPerfil") ? "page" : null)" title="Mi perfil"><partial name="_Icon" model='"user"' /><span><b>@User.Identity?.Name</b><small>@string.Join(", ", User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(claim => claim.Value == "Reconexion" ? "Reconector" : claim.Value))</small></span></a>
            <form asp-controller="Cuenta" asp-action="Logout" method="post"><button type="submit" title="Cerrar sesión"><partial name="_Icon" model='"logout"' /><span>Cerrar sesión</span></button></form>
        </div>
    </aside>
    <div class="app-main">
        <header class="app-topbar"><div class="breadcrumb"><span>VisorDatosSIG</span><span aria-hidden="true">/</span><strong>@ViewData["Title"]</strong></div></header>
        <main class="app-content" id="main-content" tabindex="-1">@RenderBody()</main>
        <footer class="footer">&copy; 2026 VisorDatosSIG</footer>
    </div>
    <partial name="_PwaInstallPrompt" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
