@model IEnumerable<VisorDatosSIG.Web.Models.UserAdministrationItem>
@{ ViewData["Title"] = "Administración de usuarios"; }
<section class="page-heading"><p class="eyebrow">Acceso restringido</p><h1>Administración de usuarios</h1><p>Consulta y mantenimiento de cuentas autorizadas.</p></section>
@if (TempData["RoleMessage"] is string roleMessage) { <p role="status">@roleMessage</p> }
<section class="admin-card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Usuario</th><th>Nombre</th><th>Rol</th><th>Estado</th><th><span class="visually-hidden">Acciones</span></th></tr></thead><tbody>
@foreach (var user in Model)
{
    <tr>
        <td><strong>@user.Login</strong></td><td>@user.Nombre</td><td>@user.Roles</td>
        <td><span class="status-badge @(user.Activo ? "active" : "inactive")">@(user.Activo ? "Activo" : "Inactivo")</span></td>
        <td>
            <form asp-action="CambiarEstado" method="post" data-confirm-action="¿Confirma que desea @(user.Activo ? "desactivar" : "activar") a @user.Login?">
                <input type="hidden" name="id" value="@user.Id" />
                <button class="btn btn-sm btn-outline-primary">@(user.Activo ? "Desactivar" : "Activar")</button>
            </form>
            @if (user.Activo)
            {
                <form asp-action="AgregarRolOperativo" method="post" class="d-flex gap-1 mt-2" data-confirm-action="¿Asignar el rol operativo seleccionado a @user.Login?">
                    <input type="hidden" name="id" value="@user.Id" />
                    <select name="role" aria-label="Rol operativo para @user.Login" class="form-select form-select-sm" required>
                        <option value="">Rol operativo</option><option value="Cortador">Cortador</option><option value="Reconexion">Reconector</option>
                    </select>
                    <button class="btn btn-sm btn-outline-primary">Agregar</button>
                </form>
            }
        </td>
    </tr>
}
</tbody></table></div></section>
