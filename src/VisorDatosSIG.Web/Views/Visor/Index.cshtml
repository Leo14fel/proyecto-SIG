@{
    ViewData["Title"] = "Visor cartográfico";
}

<partial name="~/Views/Operaciones/_MapaOperativo.cshtml" />
<section class="viewer-shell">
    <aside class="viewer-panel">
        <h1><partial name="_Icon" model='"map"' /> Visor cartográfico</h1>
        <p class="viewer-intro">Explora el catastro y el estado de las conexiones.</p>
        <a asp-action="Perspectiva" class="btn btn-outline-primary btn-sm"><partial name="_Icon" model='"cube"' /> Vista 3D</a>
        <details id="viewer-tools" class="viewer-tools mt-3" open>
        <summary><partial name="_Icon" model='"layers"' /> Capas y búsqueda</summary>
        <label class="form-label d-block mt-2">Estado de conexión
            <select id="connection-state" class="form-select form-select-sm">
                <option value="">Todos</option>
                @for (var i = 0; i < VisorDatosSIG.Domain.Entities.WaterOperations.States.Length; i++)
                {
                    <option value="@(i + 1)">@VisorDatosSIG.Domain.Entities.WaterOperations.States[i]</option>
                }
            </select>
        </label>
        <label class="form-check-label"><input type="checkbox" id="block-dimensions" class="form-check-input" /> Dimensiones de manzanas desde zoom 18</label>
        <form id="search-form" class="map-search" role="search">
            <h2>Buscar registros</h2>
            <label for="search-layer">Filtro de capa</label>
            <select id="search-layer" class="form-select form-select-sm" name="capa">
                <option value="todas" selected>Todas</option>
                <option value="codigos-fijos">Conexiones de agua</option>
                <option value="manzanas">Manzanas</option>
                <option value="lotes">Lotes</option>
                <option value="vias">Vías</option>
            </select>
            <div id="advanced-filters" hidden>
                <label for="search-field">Buscar por</label>
                <select id="search-field" class="form-select form-select-sm" name="campo"></select>
                <label for="search-operator">Operador</label>
                <select id="search-operator" class="form-select form-select-sm" name="operador">
                    <option value="contiene">Contiene</option>
                    <option value="igual">Igual</option>
                    <option value="comienza-con">Comienza con</option>
                </select>
            </div>
            <label for="search-query">Nombre o referencia</label>
            <input id="search-query" class="form-control form-control-sm" name="q" type="search" maxlength="100" aria-describedby="search-hint" required />
            <p id="search-hint" class="form-text mb-0"></p>
            <label for="search-page-size">Resultados por página</label>
            <select id="search-page-size" class="form-select form-select-sm" name="tamanoPagina">
                <option value="25" selected>25</option><option value="50">50</option><option value="100">100</option>
            </select>
            <div class="map-search-actions">
                <button class="btn btn-primary btn-sm" type="submit"><partial name="_Icon" model='"search"' /> Buscar</button>
                <button id="clear-search" class="btn btn-outline-secondary btn-sm" type="button">Limpiar</button>
            </div>
        </form>
        <section id="search-results" class="search-results" aria-live="polite" hidden>
            <p id="active-filter" class="active-filter"></p>
            <p id="search-status" class="search-status"></p>
            <button id="export-search-results" class="btn btn-outline-secondary btn-sm" type="button" hidden>Exportar resultados a CSV</button>
            <div id="search-items" class="search-items"></div>
            <div id="search-pagination" class="search-pagination"></div>
        </section>
        <div id="layer-controls" class="layer-controls" aria-label="Capas"></div>
        <button id="full-extent" class="btn btn-outline-primary w-100">Ver extensión completa</button>
        <div class="legend">
            <h2>Leyenda</h2>
            <p><i class="legend-swatch manzanas"></i>Manzanas</p>
            <p><i class="legend-swatch lotes"></i>Lotes</p>
            <p><span class="legend-swatch" style="background:#15803d"></span> Normal</p>
            <p><span class="legend-swatch" style="background:#b45309"></span> Para corte</p>
            <p><span class="legend-swatch" style="background:#b91c1c"></span> Cortado</p>
            <p><span class="legend-swatch" style="background:#7e22ce"></span> Baja parcial</p>
            <p><span class="legend-swatch" style="background:#334155"></span> Baja total</p>
            <p><i class="legend-swatch vias"></i>Vías</p>
        </div>
        <div class="viewer-notice">Lotes se carga por extensión visible desde zoom 16. Códigos Fijos se carga por extensión visible desde zoom 15 para evitar saturación.</div>
        </details>
        <div id="selection" class="selection-panel" hidden></div>
        <p id="map-message" class="map-message" role="status"></p>
    </aside>
    <div id="map" aria-label="Mapa de capas catastrales"></div>
</section>

@section Scripts {
    <script src="~/js/geographic-search.js" asp-append-version="true"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        const viewerTools = document.getElementById('viewer-tools');
        if (window.matchMedia('(max-width: 800px)').matches) viewerTools.open = false;
        const map = L.map('map', { zoomControl: false }).setView([-16.5, -68.15], 13);
        L.control.zoom({ position: 'topright' }).addTo(map);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 20,
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);
        const mapElement = document.getElementById('map');
        new ResizeObserver(() => map.invalidateSize({ pan: false })).observe(mapElement);
        window.addEventListener('orientationchange', () => setTimeout(() => map.invalidateSize({ pan: false }), 150));

        const styles = {
            'manzanas': { color: '#0f766e', weight: 1.4, fillColor: '#2dd4bf', fillOpacity: 0.12 },
            'lotes': { color: '#b45309', weight: 1, fillColor: '#fbbf24', fillOpacity: 0.09 },
            'codigos-fijos': { radius: 5, color: '#ffffff', weight: 1.5, fillColor: '#e11d48', fillOpacity: 1 },
            'vias': { color: '#1d4ed8', weight: 2.5, opacity: 0.85 }
        };
        const layers = {};
        const metadata = {};
        const requests = {};
        const colors = ['#15803d', '#b45309', '#b91c1c', '#7e22ce', '#334155'];
        const connectionState = document.getElementById('connection-state');
        const dimensions = L.layerGroup().addTo(map);
        const dimensionsToggle = document.getElementById('block-dimensions');
        let selected;
        let searchHighlight;
        let searchAbort;
        let searchState = { capa: 'todas', q: '', pagina: 1 };
        const controls = document.getElementById('layer-controls');
        const message = document.getElementById('map-message');
        const selection = document.getElementById('selection');
        const searchForm = document.getElementById('search-form');
        const searchLayer = document.getElementById('search-layer');
        const searchQuery = document.getElementById('search-query');
        const advancedFilters = document.getElementById('advanced-filters');
        const searchField = document.getElementById('search-field');
        const searchOperator = document.getElementById('search-operator');
        const searchPageSize = document.getElementById('search-page-size');
        const searchResults = document.getElementById('search-results');
        const searchStatus = document.getElementById('search-status');
        const activeFilter = document.getElementById('active-filter');
        const exportSearchResults = document.getElementById('export-search-results');
        const searchItems = document.getElementById('search-items');
        const searchPagination = document.getElementById('search-pagination');
        const geographic = window.geographicSearch;

        function setMessage(text, isError = false) {
            message.textContent = text;
            message.classList.toggle('error', isError);
        }

        function styleFor(key, feature) {
            return key === 'codigos-fijos'
                ? { ...styles[key], fillColor: colors[Number(feature?.properties?.Estado) - 1] || '#334155' }
                : styles[key];
        }

        function resetSelected() {
            if (selected) {
                selected.layer.setStyle(styleFor(selected.key, selected.feature));
            }
        }

        function selectionContent(key, feature, layer) {
            const content = document.createElement('div');
            const heading = document.createElement('h2');
            const presentation = geographic.describe(key, feature.properties);
            heading.textContent = presentation.title;
            const list = document.createElement('dl');
            const properties = presentation.details;
            if (properties.length) {
                properties.forEach(([name, value]) => {
                    const term = document.createElement('dt');
                    const description = document.createElement('dd');
                    term.textContent = name;
                    description.textContent = value ?? '-';
                    list.append(term, description);
                });
            }
            const actions = document.createElement('div');
            actions.className = 'selection-actions';
            const zoom = document.createElement('button');
            zoom.type = 'button';
            zoom.className = 'btn btn-outline-primary btn-sm';
            zoom.textContent = 'Acercar';
            zoom.addEventListener('click', () => {
                if (feature.geometry?.type === 'Point') map.flyTo(layer.getLatLng(), Math.max(map.getZoom(), 18));
                else if (layer.getBounds().isValid()) map.fitBounds(layer.getBounds(), { padding: [40, 40], maxZoom: 18 });
            });
            const clear = document.createElement('button');
            clear.type = 'button';
            clear.className = 'btn btn-outline-secondary btn-sm';
            clear.textContent = 'Limpiar selección';
            clear.addEventListener('click', clearSelection);
            const details = document.createElement('a');
            details.className = 'btn btn-outline-primary btn-sm';
            details.textContent = 'Ver detalle';
            details.href = `/Registros/${encodeURIComponent(key)}/${encodeURIComponent(feature.id)}?volver=${encodeURIComponent('/Visor')}`;
            const back = new URLSearchParams(location.search).get('volver');
            if (back && /^\/Registros(?:\?|$)/i.test(back)) {
                const returnButton = document.createElement('a');
                returnButton.className = 'btn btn-primary btn-sm';
                returnButton.textContent = 'Volver a resultados';
                returnButton.href = back;
                actions.append(returnButton);
            }
            actions.append(zoom, details, clear);
            content.append(heading, list, actions);
            return content;
        }

        function clearSelection() {
            resetSelected();
            selected?.layer.closePopup();
            selected = undefined;
            if (searchHighlight) { searchHighlight.remove(); searchHighlight = undefined; }
            selection.hidden = true;
            highlightSearchResult('', '');
        }

        function showSelection(key, feature, layer) {
            resetSelected();
            selected = { key, layer, feature };
            layer.setStyle({ color: '#111827', weight: 3, fillOpacity: 0.42 });
            highlightSearchResult(key, feature.id ?? feature.properties?.Id);
            selection.replaceChildren(selectionContent(key, feature, layer));
            selection.hidden = false;
            layer.bindPopup(selectionContent(key, feature, layer)).openPopup();
        }

        function buildLayerControl(item) {
            const id = `layer-${item.key}`;
            const wrapper = document.createElement('label');
            wrapper.className = 'layer-toggle';
            const input = document.createElement('input');
            input.id = id;
            input.type = 'checkbox';
            input.checked = item.key !== 'lotes' && item.key !== 'codigos-fijos';
            const dot = document.createElement('span');
            dot.className = `dot ${item.key}`;
            const text = document.createElement('span');
            const name = document.createElement('b');
            name.textContent = item.name;
            const count = document.createElement('small');
            count.textContent = `${item.count.toLocaleString('es-BO')} registros`;
            const state = document.createElement('em');
            state.id = `state-${item.key}`;
            text.append(name, count);
            wrapper.append(input, dot, text, state);
            input.addEventListener('change', event => event.target.checked ? loadLayer(item.key) : removeLayer(item.key));
            controls.appendChild(wrapper);
        }

        function removeLayer(key) {
            requests[key]?.abort();
            delete requests[key];
            if (layers[key]) {
                map.removeLayer(layers[key]);
                delete layers[key];
            }
            if (key === 'manzanas') drawDimensions();
        }

        async function loadLayer(key) {
            if (layers[key] || requests[key]) return;
            const control = document.getElementById(`layer-${key}`);
            if (!control?.checked) return;
            const minimumZoom = key === 'lotes' ? 16 : key === 'codigos-fijos' ? 15 : 0;
            const state = document.getElementById(`state-${key}`);
            if (map.getZoom() < minimumZoom) {
                state.textContent = 'Zoom ' + minimumZoom + '+';
                return;
            }
            const pending = new AbortController();
            requests[key] = pending;
            state.textContent = 'Cargando';
            setMessage('');
            try {
                let url = `/api/capas/${encodeURIComponent(key)}/geojson`;
                if (key === 'lotes' || key === 'codigos-fijos') {
                    const bounds = map.getBounds();
                    url += `?minX=${bounds.getWest()}&minY=${bounds.getSouth()}&maxX=${bounds.getEast()}&maxY=${bounds.getNorth()}`;
                }
                if (key === 'codigos-fijos' && connectionState.value) url += '&estado=' + connectionState.value;
                const response = await fetch(url, { signal: pending.signal, cache: 'no-store' });
                const data = await response.json();
                if (pending.signal.aborted) return;
                if (!response.ok) throw new Error(data.message || data.detail || 'Error al cargar la capa.');
                const group = L.geoJSON(data, {
                    style: () => styleFor(key),
                    pointToLayer: (feature, latlng) => L.circleMarker(latlng, styleFor(key, feature)),
                    onEachFeature: (feature, layer) => layer.on('click', () => showSelection(key, feature, layer))
                }).addTo(map);
                layers[key] = group;
                if (key === 'manzanas') drawDimensions();
                state.textContent = `${data.features.length.toLocaleString('es-BO')}`;
                if (key === 'lotes' && data.features.length === data.metadata.maximumRecords) setMessage('Se muestran hasta 3.500 lotes dentro de la extensión actual. Desplácese o acerque el mapa para consultar otros.', false);
            } catch (error) {
                if (error.name === 'AbortError') return;
                document.getElementById(`layer-${key}`).checked = false;
                setMessage(`${error.message} Vuelva a activar la capa para reintentar.`, true);
            } finally {
                if (requests[key] === pending) {
                    delete requests[key];
                    if (!layers[key]) state.textContent = '';
                }
            }
        }

        function drawDimensions() {
            dimensions.clearLayers();
            if (!dimensionsToggle.checked || map.getZoom() < 18 || !layers.manzanas) return;
            const bounds = map.getBounds();
            layers.manzanas.eachLayer(layer => {
                const shape = layer.feature.geometry;
                const rings = shape.type === 'Polygon' ? [shape.coordinates[0]] : shape.type === 'MultiPolygon' ? shape.coordinates.map(p => p[0]) : [];
                for (const ring of rings) for (let i = 1; i < ring.length; i++) {
                    const a = L.latLng(ring[i - 1][1], ring[i - 1][0]);
                    const b = L.latLng(ring[i][1], ring[i][0]);
                    const middle = L.latLng((a.lat + b.lat) / 2, (a.lng + b.lng) / 2);
                    const length = map.distance(a, b);
                    if (length >= 3 && bounds.contains(middle))
                        L.tooltip({ permanent: true, direction: 'center', className: 'block-dimension' })
                            .setLatLng(middle).setContent(length.toFixed(1) + ' m').addTo(dimensions);
                }
            });
        }

        function refreshSpatialLayer(key) {
            const control = document.getElementById(`layer-${key}`);
            if (control?.checked) { removeLayer(key); loadLayer(key); }
        }
        connectionState.addEventListener('change', () => {
            const control = document.getElementById('layer-codigos-fijos');
            if (control) { control.checked = true; refreshSpatialLayer('codigos-fijos'); }
        });
        dimensionsToggle.addEventListener('change', drawDimensions);
        let spatialTimer;
        map.on('moveend', () => {
            clearTimeout(spatialTimer);
            spatialTimer = setTimeout(() => {
                refreshSpatialLayer('lotes');
                refreshSpatialLayer('codigos-fijos');
                drawDimensions();
            }, 180);
        });

        fetch('/api/capas')
            .then(response => response.json())
            .then(items => {
                items.forEach(item => { metadata[item.key] = item; buildLayerControl(item); });
                const extent = items.map(item => item.boundingBox).find(Boolean);
                if (extent) map.fitBounds([[extent[1], extent[0]], [extent[3], extent[2]]]);
                ['manzanas', 'vias'].forEach(loadLayer);
            })
            .catch(() => setMessage('No fue posible consultar las capas SQL.', true));

        function renderSearchResults(data) {
            searchResults.hidden = false;
            activeFilter.textContent = geographic.layers[data.capa]?.label || 'Resultados';
            searchStatus.textContent = data.total
                ? `Resultados: ${data.total.toLocaleString('es-BO')} · Página ${data.pagina} de ${Math.max(1, Math.ceil(data.total / data.tamanoPagina))}`
                : 'No se encontraron resultados. Prueba con parte del nombre o cambia la capa.';
            exportSearchResults.hidden = data.items.length === 0;
            searchItems.replaceChildren();
            searchPagination.replaceChildren();

            data.items.forEach(item => {
                const entry = document.createElement('article');
                entry.className = 'search-result';
                entry.setAttribute('role', 'option');
                entry.setAttribute('aria-selected', 'false');
                entry.dataset.layer = item.layerKey;
                entry.dataset.id = String(item.id);
                const title = document.createElement('strong');
                const presentation = geographic.describe(item.layerKey, item.properties);
                title.textContent = presentation.title;
                const details = document.createElement('p');
                details.textContent = [presentation.layer, ...presentation.details.map(([name, value]) => `${name}: ${value}`)].join(' · ');
                const view = document.createElement('button');
                view.type = 'button';
                view.className = 'btn btn-outline-primary btn-sm';
                view.textContent = 'Ver en mapa';
                view.addEventListener('click', () => showSearchFeature(item.layerKey, item.id));
                entry.append(title, details, view);
                searchItems.appendChild(entry);
            });

            if (data.total > data.tamanoPagina || data.pagina > 1) {
                const previous = document.createElement('button');
                previous.type = 'button';
                previous.className = 'btn btn-outline-secondary btn-sm';
                previous.textContent = 'Anterior';
                previous.disabled = data.pagina === 1;
                previous.addEventListener('click', () => search(data.pagina - 1, true));
                const page = document.createElement('span');
                page.className = 'search-page';
                page.textContent = String(data.pagina);
                const next = document.createElement('button');
                next.type = 'button';
                next.className = 'btn btn-outline-secondary btn-sm';
                next.textContent = 'Siguiente';
                next.disabled = data.pagina >= Math.ceil(data.total / data.tamanoPagina);
                next.addEventListener('click', () => search(data.pagina + 1, true));
                searchPagination.append(previous, page, next);
            }
        }

        async function search(page = 1, keepFilters = false) {
            const q = keepFilters ? searchState.q : searchQuery.value.trim();
            if (!q) return;
            searchAbort?.abort();
            searchAbort = new AbortController();
            searchState = keepFilters ? { ...searchState, pagina: page }
                : { capa: searchLayer.value, q, pagina: page, campo: searchField.value, operador: searchOperator.value, tamanoPagina: searchPageSize.value };
            searchResults.hidden = false;
            searchItems.replaceChildren();
            searchPagination.replaceChildren();
            activeFilter.textContent = geographic.layers[searchState.capa].label;
            exportSearchResults.hidden = true;
            searchStatus.textContent = 'Buscando...';
            try {
                const params = new URLSearchParams({ capa: searchState.capa, q: searchState.q, pagina: String(page), tamanoPagina: searchState.tamanoPagina });
                if (searchState.campo) {
                    params.set('campo', searchState.campo);
                    params.set('operador', searchState.operador);
                }
                const pending = searchAbort;
                const response = await fetch(`/api/registros?${params}`, { signal: pending.signal });
                if (response.status === 401) throw new Error('Tu sesión terminó. Vuelve a iniciar sesión.');
                const data = await response.json();
                if (!response.ok) throw new Error(data.message || 'No fue posible realizar la búsqueda.');
                if (!pending.signal.aborted) renderSearchResults(data);
            } catch (error) {
                if (error.name === 'AbortError') return;
                searchStatus.textContent = error.message;
            }
        }

        async function showSearchFeature(key, id) {
            setMessage('Cargando registro seleccionado...');
            try {
                const response = await fetch(`/api/capas/${encodeURIComponent(key)}/${encodeURIComponent(id)}`);
                if (!response.ok) throw new Error(response.status === 404 ? 'El registro no existe o no tiene geometría.' : 'No fue posible cargar el registro.');
                const feature = await response.json();
                if (!feature.geometry) throw new Error('El registro no tiene geometría para mostrar.');
                if (!layers[key]) {
                    const toggle = document.getElementById(`layer-${key}`);
                    if (toggle) {
                        toggle.checked = true;
                    }
                }
                if (searchHighlight) map.removeLayer(searchHighlight);
                searchHighlight = L.geoJSON(feature, {
                    style: () => styleFor(key),
                    pointToLayer: (item, latlng) => L.circleMarker(latlng, { ...styleFor(key, item), radius: 9 }),
                    onEachFeature: (item, layer) => layer.on('click', () => showSelection(key, item, layer))
                }).addTo(map);
                const layer = searchHighlight.getLayers()[0];
                showSelection(key, feature, layer);
                const bounds = searchHighlight.getBounds();
                if (feature.geometry.type === 'Point') map.flyTo(bounds.getCenter(), Math.max(map.getZoom(), 18));
                else if (bounds.isValid()) map.fitBounds(bounds, { padding: [40, 40], maxZoom: 18 });
                setMessage('Registro mostrado en el mapa.');
            } catch (error) {
                setMessage(error.message, true);
            }
        }

        const deepLink = new URLSearchParams(location.search);
        const selectedLayer = deepLink.get('capa');
        const selectedId = Number(deepLink.get('id'));
        if (['manzanas', 'lotes', 'codigos-fijos', 'vias'].includes(selectedLayer) && Number.isInteger(selectedId) && selectedId > 0) {
            window.addEventListener('load', () => showSearchFeature(selectedLayer, selectedId), { once: true });
        } else if (deepLink.has('capa') || deepLink.has('id')) {
            setMessage('El enlace del visor no es válido.', true);
        }

        function highlightSearchResult(key, id) {
            const selectedId = String(id);
            searchItems.querySelectorAll('.search-result').forEach(entry => {
                const isMatch = entry.dataset.layer === key && entry.dataset.id === selectedId;
                entry.classList.toggle('is-selected', isMatch);
                entry.setAttribute('aria-selected', String(isMatch));
            });
        }

        function exportCurrentResults() {
            const params = new URLSearchParams({ capa: searchState.capa, q: searchState.q });
            if (searchState.capa !== 'todas' && searchState.campo) {
                params.set('campo', searchState.campo);
                params.set('operador', searchState.operador);
            }
            window.location.assign(`/api/busqueda/exportar?${params}`);
        }

        searchForm.addEventListener('submit', event => {
            event.preventDefault();
            search(1);
        });

        function populateFields() {
            advancedFilters.hidden = searchLayer.value === 'todas';
            geographic.setup(searchLayer.value, searchQuery, searchField, searchOperator);
            updateOperators();
        }

        function updateOperators() {
            geographic.updateOperator(searchField, searchOperator);
            document.getElementById('search-hint').textContent = searchField.value
                ? 'Escribe solo el valor del campo seleccionado.' : geographic.layers[searchLayer.value].hint;
        }

        searchLayer.addEventListener('change', populateFields);
        searchField.addEventListener('change', updateOperators);
        populateFields();

        document.getElementById('clear-search').addEventListener('click', () => {
            searchAbort?.abort();
            searchForm.reset();
            searchLayer.value = 'todas';
            searchResults.hidden = true;
            activeFilter.textContent = '';
            populateFields();
            exportSearchResults.hidden = true;
            searchItems.replaceChildren();
            searchPagination.replaceChildren();
        });

        exportSearchResults.addEventListener('click', exportCurrentResults);

        document.getElementById('full-extent').addEventListener('click', () => {
            const extent = Object.values(metadata).map(item => item.boundingBox).find(Boolean);
            if (extent) map.fitBounds([[extent[1], extent[0]], [extent[3], extent[2]]]);
        });
    </script>
}
